{
  "name": "ai-knowledge-assistant",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --project tsconfig.check.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:mock": "vitest run",
    "test:integration": "vitest run tests/api.test.ts",
    "models:list": "tsx scripts/list-models.ts",
    "sdk:probe": "tsx scripts/sdk-probe.ts"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "10.13.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
